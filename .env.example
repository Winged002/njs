# Newsjacking Core v3.0 Docker configuration
# Copy to .env before starting the stack.

# Required application secrets
SECRET_KEY=replace-with-a-long-random-secret
DEEPSEEK_API_KEY=replace-me

# MongoDB is private to this Docker Compose stack.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=replace-with-a-strong-root-password
MONGO_DB=newsjacking
MONGO_APP_USER=newsjacking
MONGO_APP_PASSWORD=replace-with-a-different-strong-app-password

# Model
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-flash

# Host/proxy configuration
HOST_PORT=8010
PUBLIC_BASE_URL=https://njs.syntal.pro
SESSION_COOKIE_SECURE=true
PUBLISHING_IP=95.179.253.170
PUBLISHING_PRIMARY_HOST=njs.syntal.pro
CUSTOM_DOMAIN_ROUTING=true

# v2.9 automatic custom-domain activation. The install script fills the token.
DOMAIN_AUTO_PROVISION=true
DOMAIN_PROVISIONER_SOCKET=/run/njs-domain-provisioner/provision.sock
DOMAIN_PROVISIONER_TOKEN=
DOMAIN_PROVISIONER_TIMEOUT_SECONDS=210
# Optional email for Let's Encrypt registration; blank uses Certbot without email.
CERTBOT_EMAIL=

# Guided campaign research
WEBSITE_RESEARCH_TIMEOUT_SECONDS=15
WEBSITE_RESEARCH_MAX_BYTES=1500000

# v1.8 editorial quality
ARTICLE_MIN_WORDS=900
ARTICLE_TARGET_MAX_WORDS=1700
ARTICLE_QUALITY_REWRITE_THRESHOLD=82
ARTICLE_SOURCE_RESEARCH=true

# v1.8 full landing-page generation
LANDING_MAX_VISUAL_ASSETS=8
LANDING_QUALITY_REWRITE_THRESHOLD=82
LANDING_MAX_ARTICLES=12

# Automation
NEWSJACKING_INTERVAL_SECONDS=3600
NEWSJACKING_DEFAULT_MIN_CONFIDENCE=0.65
NEWSJACKING_DEFAULT_MAX_ARTICLES_PER_RUN=10
NEWSJACKING_MAX_ARTICLES_PER_RUN=50
NEWSJACKING_MAX_ITEMS_PER_RUN=1000

# Existing credit behavior
ENABLE_CREDITS=true
NEWSJACKING_CHECK_CREDIT_COST=1
NEWSJACKING_ARTICLE_CREDIT_COST=40

# v1.8 social-media generation
# Required only when generating AI social images.
OPENAI_API_KEY=replace-with-openai-key
SOCIAL_TEXT_MODEL=deepseek-v4-flash
SOCIAL_TEXT_TEMPERATURE=0.7
SOCIAL_IMAGE_MODEL=gpt-image-2
SOCIAL_IMAGE_SIZE=1024x1024
SOCIAL_IMAGE_QUALITY=low
SOCIAL_IMAGE_OUTPUT_FORMAT=jpeg
SOCIAL_IMAGE_OUTPUT_COMPRESSION=88

# v1.8 newsletter automation
NEWSLETTER_TEXT_MODEL=deepseek-v4-flash
NEWSLETTER_DESIGN_MODEL=deepseek-v4-flash
NEWSLETTER_DESIGN_TEMPERATURE=0.45
NEWSLETTER_TEXT_TEMPERATURE=0.55
NEWSLETTER_SCHEDULE_TICK_SECONDS=900

# v1.9 collection ingestion
SUPADATA_API_KEY=
SUPADATA_BASE_URL=https://api.supadata.ai/v1
COLLECTION_MAX_UPLOAD_BYTES=26214400

# v2.1 first-party analytics
ANALYTICS_RETENTION_DAYS=730
# Optional geography can be supplied by your proxy/CDN using X-Geo-Country,
# X-Geo-Region and X-Geo-City (CF-IPCountry is also recognized for country).

# v2.6 Syntal SSO / OIDC
SSO_ENABLED=true
SSO_ISSUER=https://sso.syntal.pro
SSO_CLIENT_ID=njs
# Set this only if the njs client is confidential in Syntal SSO.
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://njs.syntal.pro/auth/callback
SSO_SCOPES=openid profile email organization permissions offline_access
SSO_REQUIRED_PERMISSION=njs.access
SSO_ADMIN_PERMISSION=njs.admin
SSO_ENFORCE_PERMISSION=true
# Emergency local-password route /auth/local. Keep false normally.
SSO_LOCAL_FALLBACK=false
SSO_ACCOUNT_URL=https://sso.syntal.pro/
SSO_ORGANIZATIONS_ENDPOINT=https://sso.syntal.pro/v1/organizations
SSO_ORGANIZATIONS_CACHE_SECONDS=120

# v2.7 article review/sign-off author profiles
AUTHOR_IMAGE_OUTPUT_DIR=/app/static/generated/authors
AUTHOR_IMAGE_URL_PREFIX=/static/generated/authors
AUTHOR_IMAGE_MAX_BYTES=8388608

# v2.8 audience capture + BlackBook CRM bridge
BLACKBOOK_BASE_URL=https://blackbook.syntal.pro
BLACKBOOK_HTTP_TIMEOUT_SECONDS=12
AUDIENCE_CAPTURE_MAX_SUBMISSIONS_PER_10_MIN=20
AUDIENCE_CAPTURE_TOKEN_MAX_AGE_SECONDS=7200
